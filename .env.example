# =============================================================================
# VARIABLES DE ENTORNO PARA DESPLIEGUE EN RAILWAY Y LOCAL
# =============================================================================

# 1. Base de Datos (Generada automáticamente por el plugin de PostgreSQL en Railway)
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/book_carousel

# 2. Orquestador n8n
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n-production.up.railway.app/

# 3. Cerebro LLM (Anthropic Claude API)
ANTHROPIC_API_KEY=sk-ant-api03-tu_api_key_aqui

# 4. Microservicio Renderizador
PORT=3001
RENDERER_URL=http://renderer:3001

# 5. Meta Graph API para Instagram
META_APP_ID=tu_meta_app_id
META_APP_SECRET=tu_meta_app_secret
META_ACCESS_TOKEN=tu_token_de_larga_duracion_aqui
META_IG_USER_ID=tu_instagram_business_account_id

# 6. Almacenamiento Cloudflare R2 (Recomendado: 10GB gratis y $0 egress fees)
R2_ACCOUNT_ID=tu_cloudflare_account_id
R2_ACCESS_KEY_ID=tu_r2_access_key_id
R2_SECRET_ACCESS_KEY=tu_r2_secret_access_key
R2_BUCKET_NAME=book-carousels
R2_PUBLIC_DOMAIN=https://pub-tu_id_de_r2.r2.dev

# Fallback S3 compatible
S3_ENDPOINT=https://<tu_cloudflare_account_id>.r2.cloudflarestorage.com
S3_BUCKET=book-carousels
S3_ACCESS_KEY_ID=tu_r2_access_key_id
S3_SECRET_ACCESS_KEY=tu_r2_secret_access_key

